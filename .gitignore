# Node.js dependencies
node_modules/

# Build output
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (keep the template)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Temporary files
*.swp
*.tmp
*.temp

# Claude Code agent config — machine/session-specific, not for the shared repo
.claude/

# Design reference material — not part of the shipped app
inspiraation photos/
inspiration links.txt

# Runtime uploads (customer/owner-uploaded dish photos) — generated content,
# not source. On Vercel these land in ephemeral /tmp anyway (see server/env-paths.js).
uploads/*
!uploads/.gitkeep

# Vercel local CLI cache
.vercel

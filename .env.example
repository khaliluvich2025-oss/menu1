# Copy this file to .env for local development (.env is gitignored).
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Local dev only — Vercel ignores this and manages the port itself.
PORT=3000

# Signs session cookies. If unset, a random secret is generated at boot,
# which means every restart (or every Vercel cold start) logs everyone out.
# Set a fixed value here for stable sessions across restarts.
SESSION_SECRET=

# Optional: pin the first-run owner/receptionist passwords instead of letting
# the server generate random ones. Recommended on Vercel, where the database
# lives in ephemeral storage (see DEPLOYMENT.md) and re-seeds on every cold
# start — without these set, the login password changes every cold start.
OWNER_PASSWORD=
RECEPTIONIST_PASSWORD=

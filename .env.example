# Copy this file to .env for local development (.env is gitignored).
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Local dev only — Vercel ignores this and manages the port itself.
PORT=3000

# REQUIRED. MongoDB connection string — categories, menu items, orders, users
# and sessions all live here now (SQLite/`/tmp` is retired). Get a free
# cluster at https://www.mongodb.com/cloud/atlas (M0 tier, no credit card),
# then use its "Connect > Drivers" connection string, e.g.:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# The server throws on boot if this isn't set — there is no fallback.
MONGODB_URI=

# Optional: database name within that cluster/connection. Defaults to
# ember_table if unset.
MONGODB_DB_NAME=

# Signs session cookies. If unset, the server falls back to a FIXED, PUBLIC
# test default (see DEPLOYMENT.md) — not a random one. A random per-boot
# secret is unusable on Vercel: multiple serverless instances would each mint
# a different secret, so a cookie signed by one instance fails verification
# on another and logins randomly appear to fail. Set a private value here
# before this is used for a real restaurant.
SESSION_SECRET=

# Optional: override the first-run owner/receptionist passwords. If unset,
# the server falls back to a FIXED, PUBLIC test default (see DEPLOYMENT.md) —
# not a random one. Now that users live in MongoDB, whichever password is
# active persists across restarts/cold starts — set these before this is used
# for a real restaurant, not just for testing.
OWNER_PASSWORD=
RECEPTIONIST_PASSWORD=
